# ---- local services ----
REDIS_URL=redis://localhost:6379/0
DUCKDB_PATH=warehouse.duckdb
CACHE_TTL_SECONDS=300

# ---- dashboard ----
DASHBOARD_URL=http://localhost:8501

# ---- email (Gmail SMTP 465 uses SSL; use an app-specific password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_address@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM=your_address@gmail.com
MAIL_TO=your_address@gmail.com

# ---- Lark webhook ----
LARK_WEBHOOK=https://open.larksuite.com/open-apis/bot/v2/hook/your-hook-id
